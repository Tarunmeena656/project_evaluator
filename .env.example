# --- Database -------------------------------------------------------------
DATABASE_URL=postgres://postgres:postgres@localhost:5432/project_evaluator

# --- API ------------------------------------------------------------------
PORT=4200
JWT_SECRET=change-me-in-production-32-bytes-minimum
# Max upload size in bytes (default 1 GiB)
MAX_UPLOAD_BYTES=1073741824

# --- Object storage (PoC: local disk; production: S3) ---------------------
STORAGE_DIR=./data/objects
WORK_DIR=./data/work

# --- LLM ------------------------------------------------------------------
# mock  = deterministic offline provider (no API key, no cost)
# anthropic = Claude via the Anthropic SDK (needs ANTHROPIC_API_KEY)
LLM_PROVIDER=mock
ANTHROPIC_API_KEY=
# Strong model for rubric scoring; cheap model for per-file summaries
LLM_MODEL_EVALUATOR=claude-opus-5-5
LLM_MODEL_SUMMARIZER=claude-haiku-5-5
# Hard cap on LLM calls per evaluation (cost/runaway guard)
LLM_MAX_CALLS_PER_EVALUATION=80

# --- Worker ---------------------------------------------------------------
WORKER_CONCURRENCY=2
# Seconds a job lease lasts before a crashed worker's job is re-delivered
JOB_LEASE_SECONDS=600
LOG_LEVEL=info
