{
  "name": "project-evaluator",
  "version": "0.1.0",
  "private": true,
  "description": "AI-powered project evaluation platform - proof of concept (API + worker + LLM evaluation pipeline)",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev:api": "tsx watch src/api/server.ts",
    "dev:worker": "tsx watch src/worker/main.ts",
    "build": "tsc -p tsconfig.json",
    "start:api": "node dist/api/server.js",
    "start:worker": "node dist/worker/main.js",
    "migrate": "tsx src/db/migrate.ts",
    "seed": "tsx src/db/seed.ts",
    "demo": "tsx scripts/demo.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.133.0",
    "@fastify/jwt": "^10.2.4",
    "@fastify/multipart": "^10.1.3",
    "fastify": "^5.12.5",
    "pg": "^8.23.1",
    "pino": "^10.4.0",
    "yauzl": "^3.4.0",
    "zod": "^4.6.6"
  },
  "devDependencies": {
    "@types/node": "^22.18.0",
    "@types/pg": "^8.23.1",
    "@types/yauzl": "^2.10.3",
    "tsx": "^4.23.15",
    "typescript": "^5.9.2",
    "vitest": "^5.0.3"
  }
}
